# Cargar la librería necesaria
library(ggplot2)
# Crear el gráfico de serie de tiempo
ggplot(frecuencia_por_tiempo, aes(x = periodo, y = frecuencia, color = Status_)) +
geom_line() +
labs(title = "Serie de Tiempo de Frecuencia de Características",
x = "Periodo",
y = "Frecuencia") +
theme_minimal()
