frecuencia_por_tiempo_Source <- Rentalcar_tabla %>%
group_by(periodo = floor_date(Fecha_Booked, "month"), Source) %>%
summarise(frecuencia = n())
ggplot(frecuencias_por_tiempo_Source, aes(x = Source, y = frecuencia, fill = Source)) +
geom_bar(stat = "identity") +
labs(title = "Frecuencia de las Características",
x = "Características",
y = "Frecuencia") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
